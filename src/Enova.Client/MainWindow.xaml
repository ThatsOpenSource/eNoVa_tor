<Window x:Class="Lragrz.Enova.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eNoVa-Tor [v0.1 // 2026]"
        Height="820" Width="1280"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Foreground" Value="#1C2833"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D5DBDB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#EBF5FB"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Background" Value="#2980B9"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#2980B9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1B4F72"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1C2833"/>
      <Setter Property="BorderBrush" Value="#D5DBDB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontSize" Value="16"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="#D5DBDB" BorderThickness="0,0,0,1" Padding="16,12">
      <DockPanel>
        <TextBlock Text="eNoVa-Tor" FontSize="16" FontWeight="SemiBold" Foreground="#1B4F72"
                   VerticalAlignment="Center" Margin="0,0,16,0"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock x:Name="UserLabel" Foreground="#5D6D7E" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="SettingsButton" Content="Einstellungen" Style="{StaticResource ToolButton}" Click="OnSettings" Visibility="Collapsed"/>
          <Button Content="Abmelden" Style="{StaticResource ToolButton}" Click="OnLogout"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="XML öffnen" Style="{StaticResource ToolButton}" Click="OnOpenXml"/>
          <Button Content="Antwort generieren und exportieren" Style="{StaticResource PrimaryButton}" Click="OnGenerateAnswer"/>
          <Button Content="PDF prüfen" Style="{StaticResource ToolButton}" Click="OnVerifyPdf"/>
          <Button Content="Warteschlange" Style="{StaticResource ToolButton}" Click="OnShowQueue"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#D5DBDB" BorderThickness="1"
              CornerRadius="8" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Vorgang" Foreground="#1B4F72" FontWeight="SemiBold" Margin="0,0,0,14"/>

            <TextBlock Text="Absender" Foreground="#5D6D7E" Margin="0,0,0,4"/>
            <TextBlock x:Name="SenderLabel" Foreground="#1C2833" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="Aktenzeichen" Foreground="#5D6D7E" Margin="0,0,0,4"/>
            <TextBox x:Name="FileNumberBox" Margin="0,0,0,12"/>

            <TextBlock Text="Sachbearbeiter" Foreground="#5D6D7E" Margin="0,0,0,4"/>
            <TextBlock x:Name="CaseworkerLabel" Foreground="#1C2833" Margin="0,0,0,12" FontWeight="SemiBold"/>

            <TextBlock Text="Entscheidung" Foreground="#5D6D7E" Margin="0,0,0,4"/>
            <ComboBox x:Name="DecisionCombo" Margin="0,0,0,12" DisplayMemberPath="Label" SelectedValuePath="Code"/>

            <TextBlock Text="Signatur" Foreground="#5D6D7E" Margin="0,0,0,4"/>
            <TextBlock x:Name="ProviderLabel" Foreground="#1C2833" Margin="0,0,0,4"/>
            <TextBlock x:Name="SignatureInfo" Foreground="#1C2833" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Height="1" Background="#E5E8E8" Margin="0,0,0,12"/>

            <TextBlock Text="Datei" Foreground="#5D6D7E" Margin="0,0,0,4"/>
            <TextBlock x:Name="LoadedFileLabel" Text="Keine Datei geladen" Foreground="#1C2833" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button Content="Datei schließen" Click="OnCloseXml" HorizontalAlignment="Left" Padding="10,4"/>

            <Border Height="1" Background="#E5E8E8" Margin="0,16,0,12"/>

            <TextBlock Text="Warteschlange" Foreground="#5D6D7E" Margin="0,0,0,6"/>
            <ListBox x:Name="QueueList" Height="140" FontSize="14" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <Button Content="Aktualisieren" Click="OnRefreshQueue" Padding="8,4" Margin="0,0,8,0"/>
              <Button Content="Leeren" Click="OnClearQueue" Padding="8,4"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Background="White" BorderBrush="#D5DBDB" BorderThickness="1"
              CornerRadius="8" ClipToBounds="True"
              AllowDrop="True"
              DragEnter="OnViewerDragEnter"
              DragOver="OnViewerDragOver"
              DragLeave="OnViewerDragLeave"
              Drop="OnViewerDrop">
        <Grid>
          <DockPanel>
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Height="40" Background="#F5F6F8">
              <StackPanel x:Name="TabBar" Orientation="Horizontal" Margin="4"/>
            </ScrollViewer>
            <ContentControl x:Name="ViewerHost" Background="White"/>
          </DockPanel>

          <Border x:Name="DropOverlay" Background="#E8F4FD" Opacity="0.95" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="Datei hier ablegen" FontSize="28" FontWeight="SemiBold" Foreground="#1B4F72" HorizontalAlignment="Center"/>
              <TextBlock Text="XML-Datei zum Öffnen" FontSize="18" Foreground="#5D6D7E" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="#D5DBDB" BorderThickness="0,1,0,0" Padding="16,8">
      <TextBlock x:Name="StatusText" Foreground="#5D6D7E" Text="Bereit"/>
    </Border>
  </Grid>
</Window>

