<Window x:Class="Lragrz.Enova.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eNoVa-Tor – Anmelden"
        Height="560" Width="440"
        MinHeight="540" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F8">
  <Grid Margin="24">
    <Border Background="White" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="8" Padding="28,24">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="eNoVa-Tor" FontSize="22" FontWeight="SemiBold" Foreground="#1B4F72" HorizontalAlignment="Center"/>
          <TextBlock Text="eNoVa_tor [v0.1 // 2026]" FontSize="12" Foreground="#5D6D7E" HorizontalAlignment="Center" Margin="0,4,0,0"/>
          <TextBlock Text="Anmeldung" FontSize="16" Foreground="#5D6D7E" HorizontalAlignment="Center" Margin="0,4,0,20"/>

          <TextBlock Text="Benutzername" Foreground="#5D6D7E" FontSize="16" Margin="0,0,0,4"/>
          <TextBox x:Name="UsernameBox" Height="40" Padding="8,6" Margin="0,0,0,12" FontSize="16"
                   BorderBrush="#D5DBDB" BorderThickness="1"/>

          <TextBlock Text="Passwort" Foreground="#5D6D7E" FontSize="16" Margin="0,0,0,4"/>
          <PasswordBox x:Name="PasswordBox" Height="40" Padding="8,6" Margin="0,0,0,10" FontSize="16"
                       BorderBrush="#D5DBDB" BorderThickness="1"/>

          <CheckBox x:Name="RememberCheck" Content="Angemeldet bleiben" FontSize="16"
                    Foreground="#5D6D7E" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
          <Button Content="Beenden" Click="OnCancel" Width="110" Height="40" Margin="0,0,8,0" FontSize="16"
                  Background="#ECF0F1" Foreground="#1C2833" BorderBrush="#D5DBDB" BorderThickness="1"/>
          <Button Content="Anmelden" Click="OnLogin" Width="130" Height="40" IsDefault="True" FontSize="16"
                  Background="#2980B9" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>

